textures/jota2_custom_src/prop_display_a
{
	qer_editorImage textures/jota2_custom_src/prop_display_a
	qer_trans 0.7
	cull disable
	{
		map textures/jota2_custom_src/prop_display_a
		blendFunc add
	}
{
		map textures/jota2_custom_src/prop_display_backlight
		blendFunc add
		rgbGen wave noise 0.5 0.3 0.1 6
	}
	{
		map textures/jota2_custom_src/prop_display_scanlines
		blendFunc add
		tcmod scale 8.25 8.25
		tcmod scroll .025 .025
	}
}

