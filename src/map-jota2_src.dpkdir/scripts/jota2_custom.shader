textures/jota2_custom_src/air_flow_distortion
{
	qer_editorImage textures/jota2_custom_src/air_flow
	qer_trans 0.5
	qer_noCarve
	surfaceparm trans
	surfaceparm nomarks
	surfaceparm noimpact
	surfaceparm nolightmap
	cull none
	nopicmip
	nomipmaps
	{
		map textures/jota2_custom_src/air_flow_distortion_hhm
		stage heathazeMap
		deformMagnitude 4
	}
