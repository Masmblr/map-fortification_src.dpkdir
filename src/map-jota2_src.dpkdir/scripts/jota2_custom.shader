textures/jota2_custom_src/floor_grate1_alpha
{
	qer_editorImage textures/jota2_custom_src/floor_grate1_d_alpha
	qer_alphaFunc gequal 0.5
	surfaceparm alphashadow
	surfaceparm trans
	surfaceparm solid
	cull none
	nopicmip
	surfaceparm metalsteps
	{
		diffuseMap textures/jota2_custom_src/floor_grate1_d_alpha
		normalMap textures/shared_ex_src/floor_grate1_n
		heightMap textures/shared_ex_src/floor_grate1_h
		specularMap textures/shared_ex_src/floor_grate1_s
		blendFunc GL_SRC_ALPHA GL_ONE_MINUS_SRC_ALPHA
		alphaFunc GE128
		depthWrite
		rgbGen identity
	}
}

