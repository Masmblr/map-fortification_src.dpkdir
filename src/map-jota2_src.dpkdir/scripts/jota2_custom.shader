textures/jota2_custom_src/decal_info
{
	qer_editorimage textures/jota2_custom_src/decal_info
	qer_alphaFunc gequal 0.5
	surfaceparm noimpact
	surfaceparm nonsolid
	surfaceparm trans
	polygonOffset
	{
		map textures/jota2_custom_src/decal_info
		blendFunc GL_SRC_ALPHA GL_ONE_MINUS_SRC_ALPHA
		rgbGen lightingDiffuse 
	}
}

